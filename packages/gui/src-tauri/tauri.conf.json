{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vivianne",
  "version": "1.8.1",
  "identifier": "com.vivianne.app",
  "build": {
    "frontendDist": "../../gui-next/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../gui-next && npm run dev",
    "beforeBuildCommand": "cd ../gui-next && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vivianne",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream",
        "minWidth": 880,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "dip_overlay",
        "create": false,
        "title": "DIP Overlay",
        "url": "overlay.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 0,
        "y": 0,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "label": "viv_instant",
        "create": false,
        "title": "Viv Instant",
        "url": "overlay.html",
        "width": 260,
        "height": 44,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 0,
        "y": 0,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "label": "viv_pointer",
        "create": false,
        "title": "Viv Pointer",
        "url": "overlay.html",
        "width": 120,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 0,
        "y": 0,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "label": "viv_activity",
        "create": false,
        "title": "Vivianne Activity",
        "url": "overlay.html",
        "width": 240,
        "height": 34,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 0,
        "y": 0,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: https://files.rcsb.org http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; frame-src 'self' blob: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDNjNCNUE1MURDRUY4QkEKUldTNitNNGRwYlZqWERmLy9tWTlCSllTM21pU2RPZkwxN3YrRU4xVkdObGFFZlFmRitha1JRaUgK",
      "endpoints": [
        "https://github.com/v3dqnt/vivianne-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
