{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vivianne",
  "version": "1.7.0",
  "identifier": "com.vivianne.app",
  "build": {
    "frontendDist": "../../gui-next/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../gui-next && npm run dev",
    "beforeBuildCommand": "cd ../gui-next && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vivianne",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "notch",
        "title": "Vivianne Voice",
        "url": "notch",
        "width": 520,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 400,
        "y": 12
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MUJEOUUxMUI5MUVCMjkKUldRcDY1RWI0ZGtibVZFNDNrT3RIMUtVSm9ueXFXU3FYaFNLQW1udnphOUJMcllxaWxZSkxsYzUK",
      "endpoints": [
        "https://github.com/v3dqnt/vivianne/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
