{
  "manifest_version": 3,
  "name": "Vivianne",
  "version": "1.3.0",
  "description": "Lets Vivianne use this browser for you: open pages, read them, click, type and take screenshots, in tabs it groups as Vivianne.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vivianne",
    "default_popup": "popup.html"
  }
}
